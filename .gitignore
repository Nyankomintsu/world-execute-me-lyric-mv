# The song and its lyrics belong to Mili: bring your own, never commit them.
/音頻&歌詞/*
!/音頻&歌詞/README.md
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.lrc
# made on your machine from your own lyric file (tools/fill_lyrics.mjs): it carries the lyric text
/data/lyrics.json

# renders (the videos carry the song)
/out/
# the site (npm run build): it carries the song and the lyrics; npm run deploy publishes it on the gh-pages branch
/dist/

# the maker's source pictures and older versions: not part of the repository
/圖片/
/backup/

# local sharing helper
/.share-runtime/
/stop-sharing.cmd

# dependencies, caches, local settings
node_modules/
.venv/
__pycache__/
*.pyc
*.log
.DS_Store
Thumbs.db
/.claude/settings.local.json
