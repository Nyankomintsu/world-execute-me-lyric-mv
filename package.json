{
  "name": "world-execute-me-lyric-mv",
  "version": "4.0.0",
  "description": "Unofficial fan-made lyric MV for Mili - world.execute(me); (deterministic renderer)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lyrics": "node tools/fill_lyrics.mjs",
    "lyrics:retime": ".venv\\Scripts\\python tools/parse_lrc.py && node tools/fill_lyrics.mjs --table",
    "check:lyrics": "node tools/check_no_lyrics.mjs",
    "analyze": ".venv\\Scripts\\python tools/analyze_audio.py",
    "dev": "node export/server.mjs --player",
    "preview": "node export/server.mjs --open",
    "build": "node tools/build_site.mjs",
    "deploy": "node tools/deploy_pages.mjs",
    "export:sample": "node export/export.mjs --start 0 --end 41 --width 960 --height 540 --fps 30 --out out/sample_0-41_540p30.mp4",
    "export:preview": "node export/export.mjs --width 1920 --height 1080 --fps 60 --cq 26 --out out/preview_1080p60.mp4",
    "export:4k": "node export/export.mjs --width 3840 --height 2160 --fps 60 --out out/world_execute_me_4k60.mp4",
    "storyboard": "node tools/storyboard.mjs",
    "check": ".venv\\Scripts\\python tools/check_flash.py out/preview_1080p60.mp4 && .venv\\Scripts\\python tools/check_sync.py out/preview_1080p60.mp4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0"
  }
}
